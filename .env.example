# Job Agent — root env (copy to .env and fill secrets)
# Used by `docker compose` (env_file) and local `go run`.
# NEXT_PUBLIC_API_URL is baked into the web image at build time (browser → host ports).

# --- Frontend (browser → API on host) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Server ---
ADDR=:8000
# Data directory (SQLite + editable YAML). Leave empty to auto-detect ./data,
# or ../data when the server is started from backend/. Compose sets /data.
DATA_DIR=
# Resume PDF directory. Leave empty to auto-detect ./resumes, or ../resumes
# when started from backend/. Compose sets /app/resumes.
RESUME_DIR=
DASHBOARD_URL=http://localhost:3000
# Comma-separated browser origins allowed to call the API.
# Defaults to DASHBOARD_URL, then http://localhost:3000.
CORS_ALLOWED_ORIGINS=

# --- Ingestion (Phase 2) ---
INGEST_CRON_ENABLED=false
INGEST_CRON_INTERVAL_HOURS=24

# --- Matcher / draft thresholds ---
AUTO_APPLY_MIN_SCORE=0.80
DRAFT_MIN_SCORE=0.75

# --- LLM / drafting (Phase 3) — optional ---
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint (OpenRouter, Groq, Together, Ollama, vLLM…).
# A full .../chat/completions URL is accepted too.
OPENAI_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Ingestion window (Phase 2) ---
# Only keep jobs posted within this many days (0 = no limit). 7 = 1 week, 30 = 1 month.
JOB_MAX_AGE_DAYS=0

# --- Telegram bot (Phase 3) — optional ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LinkedIn / Wellfound (deferred) ---
LINKEDIN_LI_AT=
WELLFOUND_SESSION=

# --- Submission pacing (Phase 5) ---
DAILY_APPLICATION_LIMIT=8
SUBMISSION_JITTER_MIN_SECONDS=45
SUBMISSION_JITTER_MAX_SECONDS=90

# --- Stage control: calibration | autonomous ---
EXECUTION_STAGE=calibration
