# Server
ADDR=:8000
# Leave empty to auto-detect ./data or ../data; Compose sets /data.
DATA_DIR=
# Leave empty to auto-detect ./resumes or ../resumes; Compose sets /app/resumes.
RESUME_DIR=
DASHBOARD_URL=http://localhost:3000
# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=

# Ingestion (Phase 2)
INGEST_CRON_ENABLED=false
INGEST_CRON_INTERVAL_HOURS=24

# Matcher / draft thresholds
AUTO_APPLY_MIN_SCORE=0.80
DRAFT_MIN_SCORE=0.75

# LLM / drafting (Phase 3) — optional
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint; a full .../chat/completions URL also works.
OPENAI_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Job age window (Phase 2): 0 = no limit, 7 = 1 week, 30 = 1 month
JOB_MAX_AGE_DAYS=0

# Telegram bot (Phase 3) — optional
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Session cookies for LinkedIn / Wellfound (deferred; not used in Phase 2)
LINKEDIN_LI_AT=
WELLFOUND_SESSION=

# Submission pacing (Phase 5)
DAILY_APPLICATION_LIMIT=8
SUBMISSION_JITTER_MIN_SECONDS=45
SUBMISSION_JITTER_MAX_SECONDS=90

# Stage control: calibration | autonomous
EXECUTION_STAGE=calibration
